
NODE_ENV=development

PORT=5000

API_PREFIX=/api/v1

MONGO_URI=<MONGODB OR MONGODB ATLAS URL>

JWT_ACCESS_SECRET=<inventory_system_secret_key>

JWT_REFRESH_SECRET=<inventory_system_refresh_key>

CORS_ORIGIN=*

# REFRESH_TOKEN_EXPIRES_IN=60s
REFRESH_TOKEN_EXPIRES_IN=15m
# ACCESS_TOKEN_EXPIRES_IN=30s
ACCESS_TOKEN_EXPIRES_IN=1d